# Copie para .env.local (local) ou cadastre na Vercel. NUNCA coloque chaves reais neste arquivo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Código que a Evellin digita uma vez em "Minha LILY". Sem ele a API recusa tudo.
LILY_ACCESS_CODE=

# Opcionais
RATE_PER_MIN=12
RATE_PER_DAY=300
# Origens extras permitidas (separadas por vírgula). Vazio = só o próprio site.
ALLOWED_ORIGINS=
